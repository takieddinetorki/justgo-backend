{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/platform/identity/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/kernel/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/events/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/auth/tsconfig.lib.json"
    }
  ]
}
