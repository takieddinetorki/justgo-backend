# All config via env — no hard-coded hosts (§20). Copy to .env for local dev.

NODE_ENV=development
PORT=3100   # Orea's Next.js dev server owns 3000 on this machine
LOG_LEVEL=info

# Self-hosted Supabase stack (infra/supabase) owns Postgres. Session pooler
# on 5432 (user postgres.<POOLER_TENANT_ID>), transaction pooler on 6543.
# Password = POSTGRES_PASSWORD from infra/supabase/.env.
DATABASE_URL=postgres://postgres.justgo:<POSTGRES_PASSWORD>@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# Self-hosted Supabase stack (auth/realtime/storage via Kong on :8000)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Self-hosted GoTrue signs HS256 by default: set JWT_SECRET (from
# infra/supabase/.env). JWKS is only for asymmetric setups.
JWT_SECRET=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# Lifetime of tokens from POST /v1/auth/session (seconds). Always capped by
# the GoTrue token it was exchanged from.
SESSION_TOKEN_TTL_SECONDS=3600

# Workers
# Every module schema with an outbox. A missing one fails silently —
# its events are written and never published.
OUTBOX_SCHEMAS=identity,suppliers,requests,orders,notifications,messaging
OUTBOX_POLL_MS=500

# Integrations (Phase 2+)
TECDOC_BASE_URL=
TECDOC_API_KEY=
TECDOC_PROVIDER_ID=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
NOMINATIM_URL=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
