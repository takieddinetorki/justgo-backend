# All config via env — no hard-coded hosts (§20). Copy to .env for local dev.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker-compose.dev.yml defaults
DATABASE_URL=postgres://justgo:justgo@localhost:5432/justgo
REDIS_URL=redis://localhost:6379

# Self-hosted Supabase stack (auth/realtime/storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when unset
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# Workers
OUTBOX_SCHEMAS=demo
OUTBOX_POLL_MS=500

# Integrations (Phase 2+)
TECDOC_BASE_URL=
TECDOC_API_KEY=
TECDOC_PROVIDER_ID=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
NOMINATIM_URL=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
